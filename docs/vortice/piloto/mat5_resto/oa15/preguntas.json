    ],
    "enunciado": "Sandra tiene x manzanas en una caja y 5 afuera. En total hay 40 manzanas. ¿Cuántas manzanas hay en la caja?",
    "alternativas": [
      {
        "id": "A",
        "texto": "30 manzanas"
      },
      {
        "id": "B",
        "texto": "45 manzanas"
      },
      {
        "id": "C",
        "texto": "40 manzanas"
      },
      {
        "id": "D",
        "texto": "35 manzanas"
      }
    ],
    "respuesta_correcta": "D",
    "explicacion_distractores": {
      "B": "Suma en vez de restar: 40 + 5 = 45.",
      "A": "Resta mal: 40 − 5 = 35, no 30.",
      "C": "Confunde el total con la cantidad en la caja."
    },
    "nivel": "basico",
    "base_libro": {
      "archivo": "MATME26E5B_1.md",
      "texto": "x + 5 = 40"
    },
    "fuente": {
